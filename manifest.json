{
  "manifest_version": 3,
  "name": "Redmine QOL Lite",
  "description": "Группы наблюдателей, превью задач и компактная лента событий внутри Redmine.",
  "version": "0.1.11",
  "permissions": ["storage", "scripting", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Redmine QOL Lite",
    "default_popup": "popup.html"
  }
}
